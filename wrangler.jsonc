{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Workers Builds で接続する Worker 名と一致させること
  "name": "warinote",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Supabase の接続先と publishable（公開用）キー。どちらもブラウザに渡す前提の公開値なのでここに書いてよい。
  // ※ secret / service_role キーは絶対に書かないこと。
  "vars": {
    "SUPABASE_URL": "https://yxqfxaqhaampcoztmcaj.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_5hy_CrLzZZYJXTPZ5n8_lg_kbhxOwYy"
  },
  // ダッシュボードで追加した変数をデプロイ時に消さない
  "keep_vars": true
}
