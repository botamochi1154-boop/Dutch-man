{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Workers Builds で接続する Worker 名と一致させること
  "name": "warinote",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // SUPABASE_URL / SUPABASE_ANON_KEY は Cloudflare ダッシュボードの
  // Settings > Variables and Secrets で設定する（デプロイ時に上書きされないよう keep_vars を有効化）。
  // ※ service_role キーは絶対に設定しないこと。
  "keep_vars": true
}
