{
  "name": "warinote",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/split.test.ts tests/settle.test.ts",
    "test:db": "bash supabase/tests/local/run.sh",
